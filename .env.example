ANTHROPIC_API_KEY=

# Search
SEARCH_PROVIDER=duckduckgo
BRAVE_API_KEY=

# Enrichment — choose one provider, set ALLOW_PAID_PROVIDERS=true to enable
# "hunter"  → Hunter.io email finder, 25 free searches/mo, no phone
# "apollo"  → Apollo.io people match, requires paid plan for email/phone
# "none"    → no enrichment (default)
ENRICHMENT_PROVIDER=none
ALLOW_PAID_PROVIDERS=false
HUNTER_API_KEY=
APOLLO_API_KEY=

WORKSPACE_ROOT=workspace
OUTPUT_ROOT=workspace/projects/mortgage-signals/outputs

MAX_SEARCHES_PER_BATCH=5
SEARCH_INTERVAL_SECONDS=10
API_INTERVAL_SECONDS=5
BATCH_COOLDOWN_SECONDS=120
SEARCH_RESULTS_PER_QUERY=5
SCRAPE_TOP_N=2
SCRAPE_TIMEOUT_SECONDS=15

DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=200
BUDGET_WARNING_RATIO=0.75
