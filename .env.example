ANTHROPIC_API_KEY=

SEARCH_PROVIDER=duckduckgo
# Set to "apollo" and ALLOW_PAID_PROVIDERS=true to enable email enrichment (free tier)
# Set to "none" to disable enrichment entirely
ENRICHMENT_PROVIDER=none
ALLOW_PAID_PROVIDERS=false

WORKSPACE_ROOT=workspace
OUTPUT_ROOT=workspace/projects/mortgage-signals/outputs

MAX_SEARCHES_PER_BATCH=5
SEARCH_INTERVAL_SECONDS=10
API_INTERVAL_SECONDS=5
BATCH_COOLDOWN_SECONDS=120
SEARCH_RESULTS_PER_QUERY=5
SCRAPE_TOP_N=2
SCRAPE_TIMEOUT_SECONDS=15
# Number of search query variants per MLO record (intent-first query always runs first)
MLO_INTENT_QUERY_VARIANTS=2
# If true, rows without strong "open to work" / "open for business" evidence are marked insufficient_evidence
REQUIRE_INTENT_SIGNAL=true
# 0.0-1.0 minimum intent confidence threshold
INTENT_MIN_CONFIDENCE=0.7

DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=200
BUDGET_WARNING_RATIO=0.75
